{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsc/node.tsbuildinfo",
    "module": "nodenext",
    "lib": ["es2024"],
    "types": ["node"]
  },
  // Tests and the GitHub Action import the page's core modules, so they are part of this project too.
  "include": ["action/**/*.mjs", "sample/**/*.mjs", "scripts/**/*.mjs", "test/**/*.mjs", "site/benchtrail/core/**/*.js"]
}
