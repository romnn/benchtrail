{
  "extends": "./tsconfig.base.json",
  // The core holds the page's logic without the browser: reading histories, detecting changes,
  // links, and the view.
  // It is checked strictly and without DOM or Node types, so it cannot reach for either.
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsc/core.tsbuildinfo",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024"],
    "types": [],
    "strict": true
  },
  "include": ["site/benchtrail/core/**/*.js", "types/core.d.ts"]
}
